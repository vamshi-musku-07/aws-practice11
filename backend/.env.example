PORT=5000
# Local / Docker Compose (service name "mongo"):
MONGODB_URI=mongodb://127.0.0.1:27017/todo-app
# Inside Compose, backend uses mongodb://mongo:27017/todo-app automatically
# Or Atlas: mongodb+srv://USER:PASS@cluster.mongodb.net/todo-app?retryWrites=true&w=majority
NODE_ENV=development
# Comma-separated origins, or * to allow all (recommended with Cloudflare tunnels)
CLIENT_URL=*
